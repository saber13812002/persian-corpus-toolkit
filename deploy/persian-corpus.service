[Unit]
Description=Persian Corpus Toolkit backend
After=network.target

[Service]
User=saber
Group=saber
WorkingDirectory=/home/saber/saberprojects/persian-corpus-toolkit/backend
Environment=HOST=127.0.0.1
Environment=PORT=5055
ExecStart=/home/saber/saberprojects/persian-corpus-toolkit/backend/.venv/bin/python server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
