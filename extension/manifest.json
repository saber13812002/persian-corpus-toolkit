{
  "manifest_version": 3,
  "name": "Persian Corpus Crawler",
  "version": "2.0",
  "description": "Crawl Persian websites for corpus building - thesaurus + khamenei.ir",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://thesaurus.eiis.iki.ac.ir/*",
    "https://farsi.khamenei.ir/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Persian Corpus Crawler"
  },
  "content_scripts": [
    {
      "matches": ["https://thesaurus.eiis.iki.ac.ir/*"],
      "js": ["content_thesaurus.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://farsi.khamenei.ir/*"],
      "js": ["content_khamenei.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
