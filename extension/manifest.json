{
  "manifest_version": 3,
  "name": "Persian Corpus Crawler",
  "version": "3.5",
  "description": "Define a tafsir project, pick page points, then read several pages a minute.",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://thesaurus.eiis.iki.ac.ir/*",
    "https://farsi.khamenei.ir/*",
    "https://corpus.ai.ismc.ir/*",
    "https://tasnim.hamtaa.org/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Persian Corpus Crawler"
  },
  "content_scripts": [
    {
      "matches": ["https://thesaurus.eiis.iki.ac.ir/*"],
      "js": ["shared.js", "content_thesaurus.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://farsi.khamenei.ir/*"],
      "js": ["shared.js", "content_khamenei.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_picker.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
